import EcdsaVerifier.CanonicalSpec
import EcdsaVerifier.OptimizedChecker
import EcdsaVerifier.EquivalenceProofs

namespace EcdsaVerifier

/-- Run internal unit and property self-tests for the Lean 4 simulator and checker. -/
def runInternalSelfTests : IO Bool := do
  -- 1. Test popcount64
  let p0 := popcount64 0 == 0
  let p1 := popcount64 1 == 1
  let pAll := popcount64 0xFFFFFFFFFFFFFFFF == 64
  let pAlt := popcount64 0x5555555555555555 == 32
  let pEdge := popcount64 0x8000000000000001 == 2
  if !(p0 && p1 && pAll && pAlt && pEdge) then
    IO.eprintln "FAIL: popcount64 self-test"
    return false

  -- 2. Test validateOp aliasing & per-kind rules
  let validCcx : Op :=
    { kind := .ccx, qControl2 := 0, qControl1 := 1, qTarget := 2
      cTarget := NO_BIT, cCondition := NO_BIT, rTarget := NO_REG }
  let alias1 : Op := { validCcx with qTarget := 1 }
  let alias2 : Op := { validCcx with qTarget := 0 }
  let alias3 : Op := { validCcx with qControl1 := 0 }
  let badAppendBoth : Op :=
    { kind := .appendToRegister, qControl2 := NO_QUBIT, qControl1 := NO_QUBIT
      qTarget := 0, cTarget := 0, cCondition := NO_BIT, rTarget := 0 }
  let goodAppendQ : Op :=
    { kind := .appendToRegister, qControl2 := NO_QUBIT, qControl1 := NO_QUBIT
      qTarget := 0, cTarget := NO_BIT, cCondition := NO_BIT, rTarget := 0 }
  if !(validateOp validCcx && !validateOp alias1 && !validateOp alias2 &&
       !validateOp alias3 && !validateOp badAppendBoth && validateOp goodAppendQ) then
    IO.eprintln "FAIL: validateOp self-test"
    return false

  -- 3. Test stepCanonical / stepOptimized on all gate types + condition stack + resets
  let st0 := SimState.init 4 2
  let opX0 : Op :=
    { kind := .x, qControl2 := NO_QUBIT, qControl1 := NO_QUBIT, qTarget := 0
      cTarget := NO_BIT, cCondition := NO_BIT, rTarget := NO_REG }
  let opX1 : Op := { opX0 with qTarget := 1 }
  let opCcx : Op := validCcx
  let opR2 : Op :=
    { kind := .r, qControl2 := NO_QUBIT, qControl1 := NO_QUBIT, qTarget := 2
      cTarget := NO_BIT, cCondition := NO_BIT, rTarget := NO_REG }
  let ops := #[opX0, opX1, opCcx, opR2]
  let rng := #[0xAAAAAAAAAAAAAAAA]
  let (stC, idxC) := runCanonical st0 ops rng 0
  let (stO, idxO) := runOptimized st0 ops rng 0
  if stC != stO || idxC != idxO || idxC != 1 then
    IO.eprintln "FAIL: runCanonical vs runOptimized self-test"
    return false
  if stO.getQubit 2 != 0 || stO.phase != 0xAAAAAAAAAAAAAAAA ||
     stO.toffoliGates != 64 || stO.cliffordGates != 64 then
    IO.eprintln "FAIL: gate/phase/reset semantics self-test"
    return false

  -- 4. Test MetaGate contracts
  let baseCert : Cert :=
    { mode := .official9024, numShots := 9024, opsValid := true, registersValid := true
      frozenHarnessHashMatch := true, classicalFailures := 0, phaseGarbageBatches := 0
      ancillaGarbageBatches := 0, qubits := 1234, toffoliTotal := 6696602112
      toffoliRounded := 742088, cliffordTotal := 0 }
  let candEst : Cert := { baseCert with mode := .estimate64, numShots := 64, toffoliRounded := 740000 }
  let candOff : Cert := { baseCert with mode := .official9024, numShots := 9024, toffoliRounded := 740000 }
  let (preEst, promoEst) := evalGateDecision candEst baseCert
  let (preOff, promoOff) := evalGateDecision candOff baseCert
  if !(preEst == true && promoEst == false && preOff == true && promoOff == true) then
    IO.eprintln "FAIL: MetaGate decision self-test"
    return false

  return true

/-- Differential test case parsed from binary suite generated by `rust_diff_driver`. -/
structure DiffTestCase where
  name            : String
  initPhase       : UInt64
  initQubits      : Array UInt64
  initBits        : Array UInt64
  opsBytes        : ByteArray
  numOps          : Nat
  rngWords        : Array UInt64
  expNumQubits    : UInt64
  expNumBits      : UInt64
  expNumRegisters : UInt64
  expPhase        : UInt64
  expToffoli      : UInt64
  expClifford     : UInt64
  expQubits       : Array UInt64
  expBits         : Array UInt64
  expRegItems     : Array (UInt64 × UInt64 × UInt64)

private def readU64ArrayLE (bs : ByteArray) (off : Nat) (count : Nat) : Array UInt64 × Nat :=
  Id.run do
    let mut arr := Array.mkEmpty count
    let mut cur := off
    for _ in [0:count] do
      arr := arr.push (readU64LE bs cur)
      cur := cur + 8
    return (arr, cur)

/-- Flatten `registers` into `(regIdx, isBit, id)` triples for exact comparison with Rust. -/
def flattenRegisters (regs : Array (Array QubitOrBit)) : Array (UInt64 × UInt64 × UInt64) :=
  Id.run do
    let mut out : Array (UInt64 × UInt64 × UInt64) := #[]
    for rIdx in [0:regs.size] do
      let reg := regs[rIdx]!
      for item in reg do
        match item with
        | .qubit qId => out := out.push (rIdx.toUInt64, (0 : UInt64), qId)
        | .bit bId   => out := out.push (rIdx.toUInt64, (1 : UInt64), bId)
    return out

/-- Parse and execute a differential test suite binary produced by `rust_diff_driver`. -/
def runDiffTestSuiteFile (path : String) : IO Bool := do
  let bs ← IO.FS.readBinFile path
  if bs.size < 16 then
    IO.eprintln s!"FAIL: diff suite {path} too short"
    return false
  let magic := String.fromUTF8! (bs.extract 0 8)
  if magic != "QECCDIFF" then
    IO.eprintln s!"FAIL: bad diff suite magic '{magic}' (expected QECCDIFF)"
    return false
  let numCases := (readU64LE bs 8).toNat
  let mut off := 16
  for caseIdx in [0:numCases] do
    let nameLen := (readU64LE bs off).toNat
    off := off + 8
    let name := String.fromUTF8! (bs.extract off (off + nameLen))
    off := off + nameLen
    let initPhase := readU64LE bs off
    let numInitQ := (readU64LE bs (off + 8)).toNat
    let numInitB := (readU64LE bs (off + 16)).toNat
    off := off + 24
    let (initQubits, off1) := readU64ArrayLE bs off numInitQ
    let (initBits, off2) := readU64ArrayLE bs off1 numInitB
    off := off2
    let numOps := (readU64LE bs off).toNat
    off := off + 8
    let opsByteLen := numOps * OP_BYTES
    let opsBytes := bs.extract off (off + opsByteLen)
    off := off + opsByteLen
    let numRng := (readU64LE bs off).toNat
    off := off + 8
    let (rngWords, off3) := readU64ArrayLE bs off numRng
    off := off3
    let expNumQubits := readU64LE bs off
    let expNumBits := readU64LE bs (off + 8)
    let expNumRegisters := readU64LE bs (off + 16)
    let expPhase := readU64LE bs (off + 24)
    let expToffoli := readU64LE bs (off + 32)
    let expClifford := readU64LE bs (off + 40)
    let numExpQ := (readU64LE bs (off + 48)).toNat
    let numExpB := (readU64LE bs (off + 56)).toNat
    let numExpRegItems := (readU64LE bs (off + 64)).toNat
    off := off + 72
    let (expQubits, off4) := readU64ArrayLE bs off numExpQ
    let (expBits, off5) := readU64ArrayLE bs off4 numExpB
    off := off5
    let mut expRegItems := Array.mkEmpty numExpRegItems
    for _ in [0:numExpRegItems] do
      let rIdx := readU64LE bs off
      let isBit := readU64LE bs (off + 8)
      let id := readU64LE bs (off + 16)
      off := off + 24
      expRegItems := expRegItems.push (rIdx, isBit, id)

    -- 1. Parse and validate ops in Lean
    let ops ← match parseOpsByteArray opsBytes numOps with
      | .ok v => pure v
      | .error e =>
        IO.eprintln s!"FAIL case {caseIdx} ({name}): parseOpsByteArray failed: {e}"
        return false

    -- 2. Check analyzeOps vs analyzeAndValidateByteArray vs Rust
    let analysis1 := analyzeOps ops
    let analysis2 ← match analyzeAndValidateByteArray opsBytes numOps with
      | .ok v => pure v
      | .error e =>
        IO.eprintln s!"FAIL case {caseIdx} ({name}): analyzeAndValidateByteArray failed: {e}"
        return false
    if analysis1 != analysis2 then
      IO.eprintln s!"FAIL case {caseIdx} ({name}): analyzeOps != analyzeAndValidateByteArray"
      return false
    let flatRegs := flattenRegisters analysis1.registers
    if analysis1.numQubits != expNumQubits ||
       analysis1.numBits != expNumBits ||
       analysis1.numRegisters != expNumRegisters ||
       flatRegs != expRegItems then
      IO.eprintln s!"FAIL case {caseIdx} ({name}): circuit analysis mismatch vs Rust"
      return false

    -- 3. Run Canonical, Optimized, and ByteArrayOptimized in Lean
    let stInit : SimState :=
      { phase := initPhase
        qubits := initQubits
        bits := initBits
        condStack := []
        currentBaseCond := 0xFFFFFFFFFFFFFFFF
        cliffordGates := 0
        toffoliGates := 0 }
    let (stCan, rngIdxCan) := runCanonical stInit ops rngWords 0
    let (stOpt, rngIdxOpt) := runOptimized stInit ops rngWords 0
    let (stByte, rngIdxByte) := runByteArrayOptimized stInit opsBytes numOps rngWords 0

    if stCan != stOpt || stOpt != stByte || rngIdxCan != rngIdxOpt || rngIdxOpt != rngIdxByte then
      IO.eprintln s!"FAIL case {caseIdx} ({name}): Lean Canonical/Optimized/ByteArray mismatch"
      return false
    if rngIdxOpt != numRng then
      IO.eprintln s!"FAIL case {caseIdx} ({name}): RNG cursor {rngIdxOpt} != expected {numRng}"
      return false
    if stOpt.phase != expPhase ||
       stOpt.toffoliGates != expToffoli ||
       stOpt.cliffordGates != expClifford ||
       stOpt.qubits != expQubits ||
       stOpt.bits != expBits then
      IO.eprintln s!"FAIL case {caseIdx} ({name}): state/stats mismatch vs Rust Simulator"
      IO.eprintln s!"  Lean: phase={stOpt.phase} tof={stOpt.toffoliGates} cliff={stOpt.cliffordGates}"
      IO.eprintln s!"  Rust: phase={expPhase} tof={expToffoli} cliff={expClifford}"
      return false
    let msg :=
      s!"  [PASS] case {caseIdx}: {name} (ops={numOps}, qubits={expNumQubits}, " ++
      s!"bits={expNumBits}, tof={expToffoli}, cliff={expClifford})"
    IO.println msg

  IO.println s!"=== All {numCases} differential test cases PASSED (100% bit-for-bit match) ==="
  return true

end EcdsaVerifier
